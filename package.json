{
  "name": "@ladamczyk/qoq",
  "version": "7.3.1",
  "description": "A streamlined suite of tools to format, lint, and analyze any JavaScript/TypeScript project with minimal setup — and a Claude Code skill that turns those checks into a guarded delivery loop.",
  "private": true,
  "bugs": {
    "url": "https://github.com/ladamczyk-it/qoq/issues"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "check:engine": "check-engine",
    "clean:modules": "rimraf -g '**/node_modules' '**/package-lock.json'",
    "config-inspector": "node ./scripts/config-inspector.js",
    "config-inspector:clean": "rimraf -g ./packages/eslint-v9-*/stats/",
    "config:diff": "node ./scripts/config-diff.js",
    "husky:pre-push": "run-s build smoke:bins check:engine test test:skill test:site qoq:check",
    "pre:test": "npm run config-inspector",
    "prepare": "husky",
    "publish:full": "run-s husky:pre-push publish:release",
    "publish:release": "npx --package semantic-release --package @semantic-release/changelog --package @semantic-release/exec --package @semantic-release/git --package semantic-release-lerna -y semantic-release",
    "qoq:scan": "qoq scan",
    "qoq:check": "qoq --check",
    "qoq:fix": "qoq --fix",
    "smoke:bins": "node ./scripts/smoke-bins.js",
    "sort:packages:json": "npx -y sort-package-json 'package.json' 'packages/*/package.json'",
    "sync:plugin-version": "node ./scripts/sync-plugin-version.js",
    "test": "npm run pre:test && vitest run",
    "test:coverage": "npm run pre:test && npm run test -- --coverage",
    "test:execute": "vitest run",
    "test:skill": "node --test 'skills/*/scripts/*.node-test.mjs'",
    "test:site": "node --test 'scripts/*.node-test.mjs' 'website/scripts/*.node-test.mjs'",
    "typecheck": "lerna run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@ladamczyk/check-engine": "latest",
    "@ladamczyk/qoq-cli": "latest",
    "@ladamczyk/qoq-eslint-v9-ts": "latest",
    "@ladamczyk/qoq-eslint-v9-ts-jest": "latest",
    "@ladamczyk/qoq-jscpd": "latest",
    "@ladamczyk/qoq-knip": "latest",
    "@ladamczyk/qoq-prettier-with-json-sort": "latest",
    "@ladamczyk/justify-disable": "1.0.1",
    "@ladamczyk/skillslint": "4.2.6",
    "@ladamczyk/structurelint": "1.1.6",
    "@types/node": "^22",
    "@vitest/coverage-v8": "5.1.1",
    "dotenv": "18.0.10",
    "husky": "9.1.7",
    "lerna": "10.1.3",
    "npm-run-all2": "9.1.0",
    "rimraf": "6.1.4",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "^22.22.2",
    "npm": ">= 10"
  }
}
