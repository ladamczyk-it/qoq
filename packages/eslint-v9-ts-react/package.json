{
  "name": "@ladamczyk/qoq-eslint-v9-ts-react",
  "version": "6.0.0",
  "description": "Eslint flat config template for TS + React",
  "keywords": [
    "eslint TypeScript + React template",
    "flat config",
    "ladamczyk",
    "qoq",
    "QualityOverQuantity"
  ],
  "homepage": "https://github.com/ladamczyk-it/qoq/tree/master/packages/eslint-v9-ts-react",
  "bugs": {
    "url": "https://github.com/ladamczyk-it/qoq/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ladamczyk-it/qoq.git",
    "directory": "packages/eslint-v9-ts-react"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "import": "./lib/index.mjs"
    }
  },
  "main": "./lib/index.mjs",
  "module": "./lib/index.mjs",
  "types": "./lib/src/index.d.ts",
  "bin": {
    "@ladamczyk/qoq-eslint-v9-ts-react": "./bin/bin.js"
  },
  "files": [
    "bin",
    "lib",
    "eslint.config.local.js",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "rimraf ./lib ./bin && rolldown -c && tsc --emitDeclarationOnly",
    "inspect": "node ./bin/bin.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.18.6",
    "@ladamczyk/qoq-eslint-v9-js": "^6.0.0",
    "@ladamczyk/qoq-eslint-v9-js-react": "^6.0.0",
    "@ladamczyk/qoq-eslint-v9-ts": "^6.0.0",
    "@ladamczyk/qoq-utils": "^6.0.0"
  },
  "devDependencies": {
    "rimraf": "6.1.3",
    "rolldown": "1.2.4",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.7.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "4c369fd421f71f58eb1d8467eaa02d85d2f09263"
}
