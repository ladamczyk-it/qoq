{
  "name": "@ladamczyk/qoq-stylelint-scss",
  "version": "5.3.1",
  "description": "Stylelint config template for SCSS",
  "keywords": [
    "stylelint SCSS template",
    "ladamczyk",
    "qoq",
    "QualityOverQuantity"
  ],
  "homepage": "https://github.com/ladamczyk-it/qoq/tree/master/packages/stylelint-scss",
  "bugs": {
    "url": "https://github.com/ladamczyk-it/qoq/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ladamczyk-it/qoq.git",
    "directory": "packages/stylelint-scss"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    }
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/src/index.d.ts",
  "files": [
    "lib",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "rimraf ./lib && rolldown -c && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ladamczyk/qoq-stylelint-css": "^5.3.1",
    "stylelint-config-standard-scss": "17.0.0"
  },
  "devDependencies": {
    "rimraf": "6.1.3",
    "rolldown": "1.2.3",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "stylelint": "^17.14.1"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
